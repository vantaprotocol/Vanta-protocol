# --- General ---
NODE_ENV=development
PORT=8787
CORS_ORIGIN=https://vantaprotocol.app


# --- AI Provider ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini


# --- DB ---
SQLITE_PATH=./data/vanta.db


# --- Solana ---
SOLANA_RPC=https://api.devnet.solana.com
# If the API needs to send txs (most flows use client wallet), provide server keypair path if desired
SERVER_SOLANA_KEYPAIR=./onchain/anchor/target/deploy/vanta-keypair.json


# --- Advanced Anchor (optional) ---
ANCHOR_PROGRAM_ID=
